<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#4E342E" android:endColor="#3E2723" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#8D6E63" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#5D4037" android:endColor="#3E2723" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#8D6E63" />
        </shape>
    </item>
</selector>
