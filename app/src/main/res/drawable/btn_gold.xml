<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <gradient android:angle="270" android:startColor="#FFB300" android:endColor="#FF8F00" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFE082" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape>
            <solid android:color="#3A2A18" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="270" android:startColor="#FFD54F" android:endColor="#FFA000" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="#FFF3C4" />
        </shape>
    </item>
</selector>
