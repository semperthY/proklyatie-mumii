<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.example.proklyatiemumii.ParallaxView
        android:id="@+id/parallax"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC0D0805"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvHeadCoins"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💰 0"
            android:textColor="#FFD54F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeadClicks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="👆 0"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeadArts"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏺 0/12"
            android:textColor="#B0BEC5"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnRebirth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌀"
            android:textSize="20sp"
            android:visibility="gone"
            android:padding="4dp" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingTop="48dp"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <FrameLayout
                android:id="@+id/flMummy"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tvSkill0" style="@style/Widget.AppCompat.Button"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                    <TextView android:id="@+id/tvSkill1"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                    <TextView android:id="@+id/tvSkill2"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/ivMummy"
                    android:layout_width="190dp"
                    android:layout_height="190dp"
                    android:layout_gravity="center"
                    android:src="@drawable/sprite_mummy"
                    android:contentDescription="Мумия" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:orientation="vertical">

                    <TextView android:id="@+id/tvSkill3"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                    <TextView android:id="@+id/tvSkill4"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                    <TextView android:id="@+id/tvSkill5"
                        android:layout_width="52dp" android:layout_height="52dp"
                        android:layout_margin="4dp" android:gravity="center"
                        android:textSize="20sp" android:background="@drawable/bg_panel" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvMana"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:text="🔮 0/100"
                    android:textColor="#80DEEA"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_panel"
                android:gravity="center"
                android:minHeight="64dp"
                android:padding="12dp"
                android:textColor="#FFCC80"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="УЛУЧШЕНИЯ"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnUpgradeTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/btn_gold"
                android:textColor="#3E2B00"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:text="Улучшить тап" />

            <Button
                android:id="@+id/btnUpgradeAuto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/btn_gold"
                android:textColor="#3E2B00"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:text="Нанять кота" />

            <Button
                android:id="@+id/btnUpgradeLuck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:background="@drawable/btn_gold"
                android:textColor="#3E2B00"
                android:textStyle="bold"
                android:text="Амулет удачи" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏺 АРТЕФАКТЫ"
                android:textColor="#FFD54F"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvArtifactStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#B0BEC5"
                android:textSize="13sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/layoutArtifacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>
    </ScrollView>

    <com.example.proklyatiemumii.ParticleView
        android:id="@+id/particleView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ImageView
        android:id="@+id/btnMute"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="48dp"
        android:layout_marginEnd="12dp"
        android:padding="6dp"
        android:src="@drawable/ic_sound_on"
        android:contentDescription="Звук" />

    <LinearLayout
        android:id="@+id/layoutRebirth"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6120A05"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌀 ПЕРЕРОЖДЕНИЕ"
            android:textColor="#FFEB3B"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRebirthText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnRebirthYes"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="ПЕРЕРОДИТЬСЯ"
            android:textStyle="bold"
            android:textColor="#3E2B00"
            android:background="@drawable/btn_gold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnRebirthNo"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="ПОЗЖЕ"
            android:textStyle="bold"
            android:textColor="#FFCC80"
            android:background="@drawable/btn_dark" />

    </LinearLayout>

</FrameLayout>
