<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:src="@drawable/sprite_mummy"
            android:layout_marginBottom="16dp"
            android:contentDescription="Мумия" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ПРОКЛЯТИЕ МУМИИ"
            android:textColor="#FFD54F"
            android:textSize="30sp"
            android:textStyle="bold"
            android:shadowColor="#80000000"
            android:shadowDx="2" android:shadowDy="2" android:shadowRadius="4"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💀 кликер про неудачливую мумию 💀"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />

    </LinearLayout>
</FrameLayout>
